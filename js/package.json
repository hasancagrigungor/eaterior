{
  "name": "eateryplan",
  "version": "1.7.0",
  "description": "Render Eatery Plan restaurant, cafe and bar floor plans on the web, React Native or Canvas — plain or illustrated, with live table and device state",
  "type": "module",
  "main": "./src/eateryplan-render.mjs",
  "types": "./types/eateryplan-render.d.ts",
  "exports": {
    ".": { "types": "./types/eateryplan-render.d.ts", "default": "./src/eateryplan-render.mjs" },
    "./illustrated": { "types": "./types/eateryplan-illustrated.d.ts", "default": "./src/eateryplan-illustrated.mjs" },
    "./package.json": "./package.json"
  },
  "bin": { "eateryplan-render": "bin/render.mjs" },
  "files": ["src", "bin", "types", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": { "test": "node --test test/*.test.mjs" },
  "keywords": ["floor-plan", "restaurant", "cafe", "bar", "svg", "react-native", "digital-twin", "pos", "renderer"],
  "homepage": "https://github.com/hasancagrigungor/eatery-plan#readme",
  "repository": { "type": "git", "url": "git+https://github.com/hasancagrigungor/eatery-plan.git", "directory": "js" },
  "bugs": { "url": "https://github.com/hasancagrigungor/eatery-plan/issues" },
  "author": "Hasan Cagri Gungor",
  "license": "MIT"
}
